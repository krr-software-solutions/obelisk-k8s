{{- /* Only found on local-ephemeral: expose the unit on a NodePort, for poking at locally. */ -}}
apiVersion: v1
kind: Service
metadata:
  name: {{ .Values.obelisk.unit }}-local
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: {{ .Values.obelisk.unit }}
  ports:
    - port: 80
      targetPort: 8080
      nodePort: 30080
