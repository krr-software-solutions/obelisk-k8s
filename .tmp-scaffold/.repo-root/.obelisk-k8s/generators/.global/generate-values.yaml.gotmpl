{{- /* The version every unit's release gets: the exact tag if HEAD has one, else 0.0.0-<short sha>, plus -dirty
       (or 0.0.0-nogit outside a git repo, where `obelisk.git` is null). */ -}}
{{- $version := "0.0.0-nogit" }}
{{- with .Values.obelisk.git }}
{{- $version = .tag.exact | default (printf "0.0.0-%s" .sha.short) }}
{{- if and .dirty .dirty.any }}{{ $version = printf "%s-dirty" $version }}{{ end }}
{{- end }}
obelisk:
  version: {{ $version | quote }}
  {{- /* Each unit is its own release, in a namespace per repo: per copy on an ephemeral target. */}}
  release:
    name: {{ .Values.obelisk.unit }}
    namespace: {{ .Values.obelisk.repo }}{{ with .Values.obelisk.ephemeral }}-{{ . }}{{ end }}

stuff:
  ab: {{ add .Values.stuff.a .Values.stuff.b }}

long-name: {{ printf "%s-%s-%s" .Values.obelisk.repo .Values.obelisk.unit .Values.obelisk.target }}

{{- if eq .Values.obelisk.target "prod" }}
prod:
  replicas: 3
  region: us-east-2
  features: [billing, audit]
  limits:
    cpu: "2"
    memory: 1Gi
{{- end }}
